# ============================================================
# Backend - Copia este archivo como .env y ajusta si hace falta.
# Los scripts `dev`, `start` y `db:migrate` cargan .env automáticamente
# con `--env-file-if-exists` (Node >= 22.9).
# ============================================================

NODE_ENV=development
PORT=3000

# PostgreSQL local levantado con `docker compose up -d db`
DATABASE_URL=postgres://credit:credit@localhost:5432/credit
TEST_DATABASE_URL=postgres://credit:credit@localhost:5432/credit_test

# Cambiar fuera de desarrollo (obligatorio en producción)
JWT_SECRET=dev-secret-cambiar

# Origen(es) del frontend separados por coma
CORS_ORIGIN=http://localhost:5173

# Buró crediticio simulado
BUREAU_BASE_URL=http://localhost:3000
BUREAU_MIN_DELAY_MS=2000
BUREAU_MAX_DELAY_MS=4000
BUREAU_FAILURE_RATE=0.3
# Debe ser mayor que BUREAU_MAX_DELAY_MS
BUREAU_TIMEOUT_MS=8000
BUREAU_MAX_ATTEMPTS=4
BUREAU_BACKOFF_BASE_MS=500
